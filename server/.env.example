# Any @ : / ? # in the username or password MUST be percent-encoded (@ -> %40, : -> %3A).
# e.g. password "S@rbajit8" -> mysql://mlmlottery:S%40rbajit8@host:3306/mlmlottery
DATABASE_URL="mysql://user:password@127.0.0.1:4306/mlmlottery_db"
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata

# Run `prisma migrate deploy` automatically on server startup, so an upload self-migrates.
# Unset = enabled on any real deployment (NODE_ENV=production, or the server started from the
# compiled dist/ via `npm start` / pm2 / systemd); disabled only under `tsx watch` dev.
# Force either way with true/false.
# MIGRATE_ON_BOOT=true

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

APP_BASE_URL=http://localhost:8083
SEED_ADMIN_EMAIL=admin@mlmlottery.local
SEED_ADMIN_PASSWORD=change-me
