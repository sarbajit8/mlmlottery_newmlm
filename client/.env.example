# Base URL the browser uses for API calls.
# Leave as "/api" to go through the Vite dev proxy (see vite.config.ts).
# Set to an absolute URL (e.g. http://localhost:5000/api) to bypass the proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies "/api" requests (the backend origin).
VITE_API_PROXY_TARGET=http://localhost:5000
